{
  "name": "orchardist",
  "version": "0.1.0",
  "description": "Sync VS Code workspace with Git worktrees",
  "keywords": [
    "git",
    "worktree"
  ],
  "license": "MIT",
  "author": "Sasha Koss <koss@nocorp.me>",
  "repository": "https://github.com/kossnocorp/orchardist",
  "publisher": "nocorp",
  "type": "module",
  "main": "./dist/dev/index.cjs",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "rollup-plugin-node-externals": "^9.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "contributes": {
    "commands": [
      {
        "command": "orchardist.refresh",
        "title": "Refresh Workspace Folders",
        "category": "Orchardist"
      }
    ],
    "configuration": {
      "title": "Orchardist",
      "properties": {
        "orchardist.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically synchronize workspace folders."
        },
        "orchardist.directory": {
          "type": "string",
          "default": "./trees",
          "scope": "window",
          "description": "Directory, relative to the main workspace folder, whose immediate child directories are added to the workspace."
        },
        "orchardist.alwaysBootstrap": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Bootstrap a detected worktree workspace without asking for confirmation."
        },
        "orchardist.mainName": {
          "type": "string",
          "default": "main",
          "scope": "window",
          "description": "Workspace display name for the main folder."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "vscode": "^1.125.0"
  }
}
