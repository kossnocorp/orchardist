{
  "name": "orchardist",
  "displayName": "Orchardist",
  "version": "0.5.1",
  "description": "Sync VS Code workspace with Git worktrees",
  "keywords": [
    "git",
    "worktree"
  ],
  "license": "MIT",
  "author": "Sasha Koss <koss@nocorp.me>",
  "repository": "https://github.com/kossnocorp/orchardist",
  "publisher": "nocorp",
  "type": "module",
  "main": "./dist/dev/index.cjs",
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "rollup-plugin-node-externals": "^9.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "contributes": {
    "commands": [
      {
        "command": "orchardist.focusWorktree",
        "title": "Focus Single Worktree",
        "category": "Orchardist"
      },
      {
        "command": "orchardist.focusMultipleWorktrees",
        "title": "Focus Multiple Worktrees",
        "category": "Orchardist"
      },
      {
        "command": "orchardist.unfocusWorktree",
        "title": "Unfocus Worktree",
        "category": "Orchardist"
      },
      {
        "command": "orchardist.openWorktreeInNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Orchardist"
      },
      {
        "command": "orchardist.newTerminal",
        "title": "New Terminal",
        "category": "Orchardist"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "orchardist.focusWorktree",
          "when": "orchardist.managedWorkspace"
        },
        {
          "command": "orchardist.focusMultipleWorktrees",
          "when": "orchardist.managedWorkspace"
        },
        {
          "command": "orchardist.unfocusWorktree",
          "when": "orchardist.managedWorkspace && orchardist.focusedWorktree"
        },
        {
          "command": "orchardist.openWorktreeInNewWindow",
          "when": "orchardist.managedWorkspace"
        },
        {
          "command": "orchardist.newTerminal",
          "when": "orchardist.managedWorkspace"
        }
      ]
    },
    "configuration": {
      "title": "Orchardist",
      "properties": {
        "orchardist.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically synchronize workspace folders."
        },
        "orchardist.alwaysBootstrap": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Bootstrap a detected worktree workspace without asking for confirmation."
        },
        "orchardist.mainName": {
          "type": "string",
          "default": "main",
          "scope": "window",
          "description": "Workspace display name for the main folder."
        },
        "orchardist.workspaceFileName": {
          "type": "string",
          "default": "${workspaceFolderBasename}.wt.code-workspace",
          "scope": "window",
          "description": "Workspace filename. ${workspaceFolderBasename} expands to the main worktree directory name."
        },
        "orchardist.ignoreWorkspaceFile": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically add the generated workspace file to .gitignore."
        },
        "orchardist.filterFiles": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Hide files from unfocused worktrees in Quick Open and workspace search results using managed absolute search.exclude patterns."
        },
        "orchardist.discriminators": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show worktree symbols in workspace folder names and editor labels."
        },
        "orchardist.discriminatorSymbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "🟢",
            "🔵",
            "🟣",
            "🟡",
            "🔴",
            "⚪️",
            "🟠",
            "🟤",
            "⚫️"
          ],
          "scope": "window",
          "description": "Ordered symbols used to distinguish worktrees. Symbols repeat when there are more worktrees than entries."
        },
        "orchardist.discriminatorHistory": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": [],
          "scope": "window",
          "description": "Orchardist-managed symbol assignment history for this workspace."
        },
        "orchardist.discriminatorPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Orchardist-managed custom label patterns used to clean up stale worktree labels. Do not edit this setting manually."
        },
        "orchardist.fileExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Orchardist-managed search exclusion patterns used to hide unfocused worktrees from Quick Open and workspace search results. Do not edit this setting manually."
        }
      }
    }
  },
  "activationEvents": [
    "*"
  ],
  "icon": "./assets/icon.png",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "vscode": "^1.125.0"
  }
}
